<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        通过空 Shape 占位让 Builder 能区分“沿用系统/主题按钮图标”和“调用方明确清空图标”。
        构造时不会真正显示占位资源，而是取回 CompoundButton 当前 android:button。
    -->
    <style name="ShapeCheckBoxStyle" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="shape_buttonDrawable">@drawable/shape_view_placeholder</item>
    </style>

    <style name="ShapeRadioButtonStyle" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="shape_buttonDrawable">@drawable/shape_view_placeholder</item>
    </style>

    <!--
        ShapeSwitchButton 的默认轨道外观。控件自身会在 onDraw 中绘制滑块，
        轨道则由 ShapeDrawableBuilder 根据 shape_* 状态属性绘制。
    -->
    <style name="ShapeSwitchButtonStyle" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="shape_solidColor">#FFDDDDDD</item>
        <item name="shape_solidCheckedColor">#FF40B5FF</item>
        <item name="shape_radius">999dp</item>
        <item name="shape_switchThumbColor">#FFFFFFFF</item>
        <item name="shape_switchAnimationEnable">true</item>
    </style>

</resources>
